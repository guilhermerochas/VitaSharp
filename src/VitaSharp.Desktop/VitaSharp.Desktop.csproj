<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VitaSharp.Core\VitaSharp.Core.csproj" />
    <ProjectReference Include="..\VitaSharp.Renderer.Vulkan\VitaSharp.Renderer.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="FlashCap" Version="1.12.0" />
    <!-- transitive dependency of Avalonia 11.3.0 with a known vulnerability (GHSA-xrw6-gwf8-vvr9): pin the patched release -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- game controllers (SDL GameControllerDB mappings, hot-plug, DualShock 4 / DualSense touch pads) -->
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <!--
    Debug tool, off by default: `dotnet build -p:Lockstep=true` adds Lockstep.cs, which runs real game code on Unicorn
    next to our interpreter and logs every instruction whose results differ (VITASHARP_LOCKSTEP=STARTPC:BLOCKS:FROMFRAME).
    Unicorn exits its generated code with longjmp, which the CET shadow stack of .NET apphosts rejects: CET is off then.
  -->
  <PropertyGroup Condition="'$(Lockstep)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCKSTEP</DefineConstants>
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup Condition="'$(Lockstep)' == 'true'">
    <PackageReference Include="UnicornEngine.Unicorn" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Lockstep)' != 'true'">
    <Compile Remove="Lockstep.cs" />
  </ItemGroup>

  <!-- FFmpeg (LGPL) for SceAvPlayer movies and SceAudiodec MP3/AAC: downloaded per platform at build time -->
  <Import Project="..\..\build\FFmpeg.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- keep freed GC segments for reuse instead of returning them to the OS (steady per-frame allocation churn) -->
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- platforms VitaSharp is published for (build/publish.sh, build/publish.ps1); plain builds stay portable -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- icons rendered from docs/assets/logo.svg by build/make-icons.ps1 / build/make-icons.sh (committed) -->
    <ApplicationIcon>Assets\VitaSharp.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- window and taskbar icons of the launcher (Avalonia) and the game window (GLFW), see Host/AppIcon.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\VitaSharp.ico" LogicalName="VitaSharp.ico" />
    <EmbeddedResource Include="Assets\icon-16.png;Assets\icon-24.png;Assets\icon-32.png;Assets\icon-48.png;Assets\icon-64.png;Assets\icon-128.png;Assets\icon-256.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- self-contained single-file release (dotnet publish -r <rid> -p:VitaSharpRelease=true): the managed code is
       bundled into one ReadyToRun executable; native libraries (GLFW, OpenAL Soft, shaderc, Skia) stay next to it,
       with FFmpeg in ffmpeg/ -->
  <PropertyGroup Condition="'$(VitaSharpRelease)' == 'true' and '$(VitaSharpAot)' != 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Native AOT release (dotnet publish -r <rid> -p:VitaSharpRelease=true -p:VitaSharpAot=true): the whole app is
       compiled ahead of time into one native executable (no JIT at run time, faster start, less memory). It must be
       built on the target OS (Windows needs the MSVC build tools, Linux clang + zlib, macOS the Xcode command-line
       tools); native libraries stay next to it as above. The IL CPU backend is unavailable (no Reflection.Emit). -->
  <PropertyGroup Condition="'$(VitaSharpRelease)' == 'true' and '$(VitaSharpAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- pdb (Windows) / dbg (Unix) symbols beside the executable instead of inside it -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- trim/AOT analyzers on every build, so new reflection or Reflection.Emit use shows up as a warning right away -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- DirectShow webcams need runtime-generated COM interop: off in trimmed/AOT builds (Media Foundation instead) -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">
    <RuntimeHostConfigurationOption Include="VitaSharp.Camera.DirectShow" Value="false" Trim="true" />
  </ItemGroup>

</Project>
