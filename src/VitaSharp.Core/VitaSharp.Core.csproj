<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-agnostic emulator core: no windowing, no graphics API, no OS specifics.
       Desktop and (future) Android front-ends plug into it through the interfaces in Host/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VitaSharp.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile-time HLE binder (source generator, analyzer only) -->
    <ProjectReference Include="..\VitaSharp.Core.Generators\VitaSharp.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" UndefineProperties="RuntimeIdentifier;PublishAot;PublishTrimmed;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hle\Data\nids.txt" LogicalName="nids.txt" />
    <InternalsVisibleTo Include="VitaSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- x86-64 encoder for the native CPU backend (MIT, pure C#, Native AOT compatible) -->
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
  </ItemGroup>

</Project>

