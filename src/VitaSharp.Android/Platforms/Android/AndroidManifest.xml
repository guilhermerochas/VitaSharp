<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Vulkan 1.1+ is required by the renderer (it asks for 1.3 and checks what the device has) -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <!-- "Internet real" (opt-in) and RPCN; nothing is sent while it is off -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- SceCamera: the phone's cameras, asked at run time when a game first starts a camera (denied = grey frames) -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- SceAudioIn: the phone's microphone, asked at run time when a game first opens its microphone port (denied = silence) -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- the phone's position as the Vita's (SceLibLocation), only with Ajustes > Localizacao on and asked when a game
       first asks for it -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- the data folder /storage/emulated/0/.vitasharp, visible and editable (Mobile.Core DataRoot, StorageSetup):
       "All files access" on Android 11+, the storage permission on Android 8-10; not asked on a rooted device -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
  <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
  <application
      android:label="VitaSharp"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:requestLegacyExternalStorage="true"
      android:largeHeap="true"
      android:isGame="true"
      android:extractNativeLibs="true"
      android:appCategory="game"
      android:supportsRtl="true">
    <!-- simpleperf / Perfetto CPU profiles of a release build from adb (API 29+); no debugger, no run-as -->
    <profileable android:shell="true" />
    <!-- game mode support (performance / battery), read back by GameActivity -->
    <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
  </application>
</manifest>
