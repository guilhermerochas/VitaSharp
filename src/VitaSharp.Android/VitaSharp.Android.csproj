<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The VitaSharp Android app: .NET MAUI with MauiReactor (declarative C#, no XAML) for the screens of docs/android,
    a native activity for the game (SurfaceView + Vulkan, Platforms/Android/Game), logcat logging, the AAudio/AudioTrack and
    MediaCodec backends and the libadrenotools GPU driver loader. The platform-neutral models are in
    VitaSharp.Mobile.Core (part of VitaSharp.sln and unit-tested).

    Not part of VitaSharp.sln: building it needs the .NET MAUI Android workload (dotnet workload install maui-android)
    and the Android SDK, which the desktop build does not require. Build it on its own or through VitaSharp.Android.sln:
      dotnet build src/VitaSharp.Android -c Release -m:2
    (docs/android/README.md, "Building").
  -->
  <!-- Android SDK: -p:AndroidSdkDirectory= wins (a global property); otherwise the first SDK that has the target API
       platform (android-36): ANDROID_HOME, ANDROID_SDK_ROOT, an AndroidSdkDirectory environment variable (Visual Studio's
       Xamarin installer sets one machine-wide, often to an older SDK), then the Android Studio default for the platform
       (%LOCALAPPDATA%\Android\Sdk, ~/Library/Android/sdk, ~/Android/Sdk). -->
  <PropertyGroup>
    <_VitaSharpAndroidApi>android-36</_VitaSharpAndroidApi>
    <_VitaSharpEnvSdk>$(AndroidSdkDirectory)</_VitaSharpEnvSdk>
    <AndroidSdkDirectory></AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(ANDROID_HOME)' != '' and Exists('$(ANDROID_HOME)/platforms/$(_VitaSharpAndroidApi)')">$(ANDROID_HOME)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_SDK_ROOT)' != '' and Exists('$(ANDROID_SDK_ROOT)/platforms/$(_VitaSharpAndroidApi)')">$(ANDROID_SDK_ROOT)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(_VitaSharpEnvSdk)' != '' and Exists('$(_VitaSharpEnvSdk)/platforms/$(_VitaSharpAndroidApi)')">$(_VitaSharpEnvSdk)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and Exists('$(LOCALAPPDATA)\Android\Sdk\platforms\$(_VitaSharpAndroidApi)')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(HOME)/Library/Android/sdk/platforms/$(_VitaSharpAndroidApi)')">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and Exists('$(HOME)/Android/Sdk/platforms/$(_VitaSharpAndroidApi)')">$(HOME)/Android/Sdk</AndroidSdkDirectory>
    <!-- none has the platform: keep whatever was configured, so the SDK's own XA5207 message names it -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">$(_VitaSharpEnvSdk)</AndroidSdkDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VitaSharp.Android</RootNamespace>
    <AssemblyName>VitaSharp.Android</AssemblyName>

    <ApplicationTitle>VitaSharp</ApplicationTitle>
    <!-- developer flavour (-p:VitaSharpDeveloper=true, Directory.Build.props): same package id, so install -r keeps the data -->
    <ApplicationTitle Condition="'$(VitaSharpDeveloper)' == 'true'">VitaSharp Dev</ApplicationTitle>

    <ApplicationId>io.github.vitasharp</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <!-- phones (arm64-v8a) and the x86_64 Android emulator; 32-bit ABIs are not supported (4 GiB guest reservation) -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- `-r <rid>` (a phone: android-arm64, the emulator: android-x64) builds and AOT-compiles only that ABI; without
         it the APK carries both. .NET for Android otherwise still AOT-compiles every RuntimeIdentifiers entry, which
         doubles the LLVM AOT time of a local -r android-arm64 build -->
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!--
      Runtime (VitaSharpAndroidRuntime below): Release builds are Native AOT (no JIT: the native ARM64 CPU backend and
      the interpreter, no IL backend); Debug builds run on Mono with its JIT; CoreCLR and Mono AOT stay selectable
      (docs/android/README.md, "Runtime and CPU backends").
    -->
    <UseInterpreter>false</UseInterpreter>
    <!-- the emulator reflects over nothing at run time, but the core and Silk.NET are not trim-annotated: keep them -->
    <TrimMode>partial</TrimMode>
    <!-- guest threads and the GPU worker allocate steadily: concurrent GC, keep segments -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    Runtime and AOT: -p:VitaSharpAndroidRuntime=mono-jit|mono-aot|mono-aot-llvm|coreclr|nativeaot (docs/android/README.md,
    "Runtime and CPU backends"). Release defaults to nativeaot (measured fastest on a phone, 09/11/2026: Killzone 21-23
    fps against 13.5-14 with mono-aot), Debug to mono-jit. Every choice but nativeaot keeps a JIT, so dynamic code stays supported and compiled and the CPU chain is still native > il >
    interpreter (nativeaot: native > interpreter).
      mono-jit       Mono with its JIT; in Release the .NET for Android default profiled AOT (the startup methods of
                     the MAUI profiles and the app assembly; VitaSharp.Core and the renderer are JIT-compiled on the
                     device)
      mono-aot       Mono, every method of every assembly AOT-compiled (AndroidAotMode=Normal: the JIT stays and
                     compiles what AOT cannot cover: UnsafeAccessor stubs, some generic instantiations, DynamicMethods)
      mono-aot-llvm  mono-aot through LLVM (opt/llc of the AOT cross pack); the Release default until 09/11/2026: about
                     17 min to build instead of 5, but F1 2011 races ran 35% faster on the phone than with mono-aot
      coreclr        CoreCLR (RyuJIT with tiered PGO over a composite ReadyToRun image), experimental in .NET 10
                     (warning XA1040)
      nativeaot      Native AOT (ILC, the whole app in one libVitaSharp.Android.so, CoreCLR's GC, no JIT); the Release
                     default (experimental in .NET 10 for Android); about 10 min to build; needs the NDK (AndroidNdkDirectory, else the newest <Android SDK>/ndk/<version>)
  -->
  <PropertyGroup>
    <VitaSharpAndroidRuntime Condition="'$(VitaSharpAndroidRuntime)' == '' and '$(Configuration)' == 'Release'">nativeaot</VitaSharpAndroidRuntime>
    <VitaSharpAndroidRuntime Condition="'$(VitaSharpAndroidRuntime)' == ''">mono-jit</VitaSharpAndroidRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VitaSharpAndroidRuntime)' == 'mono-aot' or '$(VitaSharpAndroidRuntime)' == 'mono-aot-llvm'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidAotMode>Normal</AndroidAotMode>
  </PropertyGroup>
  <!-- Mono's AOT task starts one compiler per logical CPU (and LLVM adds opt/llc to each), which pins every core of the
       build machine: one assembly at a time per ABI unless -p:VitaSharpParallelAot=true -->
  <PropertyGroup Condition="'$(VitaSharpParallelAot)' != 'true'">
    <_DisableParallelAot Condition="'$(_DisableParallelAot)' == ''">true</_DisableParallelAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VitaSharpAndroidRuntime)' == 'mono-aot-llvm'">
    <EnableLLVM>true</EnableLLVM>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VitaSharpAndroidRuntime)' == 'coreclr' or '$(VitaSharpAndroidRuntime)' == 'nativeaot'">
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VitaSharpAndroidRuntime)' == 'nativeaot'">
    <PublishAot>true</PublishAot>
    <_VitaSharpNdks Condition="'$(AndroidNdkDirectory)' == '' and '$(ANDROID_NDK_ROOT)' == '' and Exists('$(AndroidSdkDirectory)/ndk')">$([System.IO.Directory]::GetDirectories('$(AndroidSdkDirectory)/ndk'))</_VitaSharpNdks>
    <AndroidNdkDirectory Condition="'$(AndroidNdkDirectory)' == '' and '$(ANDROID_NDK_ROOT)' != ''">$(ANDROID_NDK_ROOT)</AndroidNdkDirectory>
    <AndroidNdkDirectory Condition="'$(AndroidNdkDirectory)' == '' and '$(_VitaSharpNdks)' != ''">$(_VitaSharpNdks.Substring($([MSBuild]::Add($(_VitaSharpNdks.LastIndexOf(';')), 1))))</AndroidNdkDirectory>
  </PropertyGroup>
  <!-- the choice is logged at startup (RuntimeReport: "Runtime: ..., build mono-aot") so phone logs say what ran -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>VitaSharpAndroidRuntime</_Parameter1>
      <_Parameter2>$(VitaSharpAndroidRuntime)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="_VitaSharpCheckAndroidRuntime" BeforeTargets="PrepareForBuild"
      Condition="'$(VitaSharpAndroidRuntime)' != 'mono-jit' and '$(VitaSharpAndroidRuntime)' != 'mono-aot' and '$(VitaSharpAndroidRuntime)' != 'mono-aot-llvm' and '$(VitaSharpAndroidRuntime)' != 'coreclr' and '$(VitaSharpAndroidRuntime)' != 'nativeaot'">
    <Error Text="VitaSharpAndroidRuntime='$(VitaSharpAndroidRuntime)': use mono-jit, mono-aot, mono-aot-llvm, coreclr or nativeaot" />
  </Target>
  <Target Name="_VitaSharpCheckNdk" BeforeTargets="PrepareForBuild"
      Condition="'$(VitaSharpAndroidRuntime)' == 'nativeaot' and ('$(AndroidNdkDirectory)' == '' or !Exists('$(AndroidNdkDirectory)'))">
    <Error Text="VitaSharpAndroidRuntime=nativeaot needs the Android NDK: install it with the SDK manager (ndk;&lt;version&gt;) or pass -p:AndroidNdkDirectory=&lt;dir&gt;; -p:VitaSharpAndroidRuntime=mono-aot-llvm builds without it" />
  </Target>

  <!--
    Native AOT fixes for .NET for Android 36.1 (all measured on the 36.1.69 workload with NDK r30):
    - the runtime pack's static libRuntime carries its own libunwind and clang adds the NDK's libunwind.a: duplicate
      __unw_* symbols. Without the NDK's the static libc++abi misses _Unwind_*; both are LLVM libunwind, so the first
      definition (the runtime's) wins.
    - the Android runtime pack ships System.IO.Hashing 9.0 next to the core's 10.0 package: both reach the packaging
      steps (XAAMP7004 duplicate key); the newer one is kept.
    - ILC is not given the generated resource-designer assembly that MAUI's activities use (MainActivity.OnCreate
      threw FileNotFoundException at launch) nor the referenced projects' satellite assemblies (pt-BR texts).
  -->
  <ItemGroup Condition="'$(VitaSharpAndroidRuntime)' == 'nativeaot'">
    <LinkerArg Include="-Wl,--allow-multiple-definition" />
  </ItemGroup>
  <Target Name="_VitaSharpNativeAotInputs" AfterTargets="_AndroidComputeIlcCompileInputs" Condition="'$(VitaSharpAndroidRuntime)' == 'nativeaot'">
    <ItemGroup>
      <_VsKeep Include="@(ResolvedFileToPublish)" Condition="'%(Filename)' != 'System.IO.Hashing' or '%(ResolvedFileToPublish.NuGetPackageId)' == 'System.IO.Hashing'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_VsKeep)" />
      <IlcReference Include="$(IntermediateLinkDir)_Microsoft.Android.Resource.Designer.dll" Condition="Exists('$(IntermediateLinkDir)_Microsoft.Android.Resource.Designer.dll')" />
      <_VsSatellite Include="$(IntermediateLinkDir)*\*.resources.dll" />
      <IlcSatelliteAssembly Include="@(_VsSatellite)" Exclude="@(IlcSatelliteAssembly)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VitaSharp.Core\VitaSharp.Core.csproj" />
    <ProjectReference Include="..\VitaSharp.Renderer.Vulkan\VitaSharp.Renderer.Vulkan.csproj" />
    <ProjectReference Include="..\VitaSharp.Mobile.Core\VitaSharp.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Reactor.Maui" Version="4.0.19" />
    <!-- Silk.NET.Shaderc.Native (from the renderer) carries glibc builds for desktop Linux, which cannot load on Android:
         keep them out of the APK. The Android libshaderc_shared.so comes from the NDK build (docs/android/README.md) -->
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- libshaderc_shared.so built from the NDK's shaderc by build/build-android-shaderc.ps1 or .sh (not committed): packaged
       when present; without it the renderer cannot compile shaders on the device -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\third_party\android-shaderc\libs\arm64-v8a\libshaderc_shared.so" Abi="arm64-v8a"
        Condition="Exists('..\..\third_party\android-shaderc\libs\arm64-v8a\libshaderc_shared.so')" />
    <AndroidNativeLibrary Include="..\..\third_party\android-shaderc\libs\x86_64\libshaderc_shared.so" Abi="x86_64"
        Condition="Exists('..\..\third_party\android-shaderc\libs\x86_64\libshaderc_shared.so')" />
  </ItemGroup>

  <!-- Diagnostic builds: -p:VitaSharpValidationLayer=<dir>/arm64-v8a/libVkLayer_khronos_validation.so (Android binaries
       from the Vulkan-ValidationLayers releases) packages the Khronos validation layer; VITASHARP_VK_VALIDATION=1 in
       env.txt enables it (the loader finds layers in the app's own native library directory) -->
  <ItemGroup Condition="'$(VitaSharpValidationLayer)' != ''">
    <AndroidNativeLibrary Include="$(VitaSharpValidationLayer)" Abi="arm64-v8a" />
  </ItemGroup>

  <!-- Runtime environment set before the .NET runtime starts (-p:VitaSharpAndroidEnv=<file of KEY=VALUE lines>): the
       DOTNET_* knobs of CoreCLR (GC, tiering, perf map) are read at runtime start, before config/env.txt is applied -->
  <ItemGroup Condition="'$(VitaSharpAndroidEnv)' != ''">
    <AndroidEnvironment Include="$(VitaSharpAndroidEnv)" />
  </ItemGroup>

  <!-- libadrenotools and its hook libraries (arm64-v8a only), built by build/build-android-adrenotools.ps1 or .sh (not
       committed): packaged when present; without them "Driver da GPU" cannot load custom drivers and the system Vulkan
       driver is used. libadrenotools loads the hooks by path from the native library directory, so the manifest has
       the libraries extracted at install (android:extractNativeLibs="true") -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\third_party\android-adrenotools\libs\arm64-v8a\*.so" Abi="arm64-v8a" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sora (headings) and Inter (text), SIL Open Font License 1.1: Resources/Fonts/OFL-*.txt -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <TrimmerRootAssembly Include="VitaSharp.Core" RootMode="All" />
    <TrimmerRootAssembly Include="VitaSharp.Renderer.Vulkan" RootMode="All" />
  </ItemGroup>

</Project>
