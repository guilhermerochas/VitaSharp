<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android-only media backends (skeletons): NDK MediaCodec video decoding and AAudio output behind the core's
    IVideoDecoderBackend / IAudioBackend interfaces, the libadrenotools GPU driver loader, and the platform-neutral
    models behind the screens in docs/android (Gpu/GpuDriverScreen.cs, Firmware/FirmwareSetup.cs,
    Input/OnScreenControls.cs, Settings/AppSettings.cs). Resources/ holds the adaptive launcher icon generated by
    build/make-icons.ps1 (AndroidResource items by default; the app's manifest uses @mipmap/ic_launcher and
    @mipmap/ic_launcher_round). Not part of VitaSharp.sln and not referenced by the desktop projects: building it needs
    the .NET Android workload (dotnet workload install android), which the desktop build does not require. The future
    Android front-end references this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VitaSharp.Android</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VitaSharp.Core\VitaSharp.Core.csproj" />
    <!-- the Vulkan renderer, for the custom GPU driver hook (Gpu/AdrenoToolsDriverLoader.cs) -->
    <ProjectReference Include="..\VitaSharp.Renderer.Vulkan\VitaSharp.Renderer.Vulkan.csproj" />
  </ItemGroup>

</Project>
