<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android-only media backends (skeletons): NDK MediaCodec video decoding and AAudio output behind the core's
    IVideoDecoderBackend / IAudioBackend interfaces. Not part of VitaSharp.sln and not referenced by the desktop
    projects: building it needs the .NET Android workload (dotnet workload install android), which the desktop build
    does not require. The future Android front-end references this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VitaSharp.Android</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VitaSharp.Core\VitaSharp.Core.csproj" />
  </ItemGroup>

</Project>
