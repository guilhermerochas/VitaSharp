<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders docs/assets/logo.svg into the application icons committed under src/VitaSharp.Desktop/Assets
    (build/make-icons.ps1 or build/make-icons.sh runs it). Pure .NET (Svg.Skia + SkiaSharp), so any OS can regenerate
    the icons without Inkscape or ImageMagick. Not part of VitaSharp.sln: it only runs when the logo changes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

</Project>
