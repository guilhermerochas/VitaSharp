<Project>
  <!--
    Downloads the FFmpeg shared libraries (LGPL build from https://github.com/BtbN/FFmpeg-Builds) for the platform
    being built, verifies the archive's SHA-256 and copies the libraries to "ffmpeg/" next to the executable, where
    VitaSharp.Core.Media.FFmpegLoader looks for them. They are kept out of git; the extracted copy is cached in
    third_party/ffmpeg/<rid>/ so only the first build downloads.

    The release is a month-end autobuild tag: BtbN keeps those indefinitely, unlike the daily ones.
    To update FFmpeg: pick a new month-end tag, change FFmpegTag/FFmpegBuild and the four hashes (the GitHub release
    page lists each asset's sha256), and keep the major version in line with the FFmpeg.AutoGen package.

    Platforms without a BtbN build (macOS) use the system FFmpeg instead (brew install ffmpeg).
    Set VitaSharpSkipFFmpeg=true to build without downloading; videos and MP3/AAC audio are then disabled.
  -->
  <PropertyGroup>
    <FFmpegTag>autobuild-2026-09-30-13-08</FFmpegTag>
    <FFmpegBuild>ffmpeg-n8.1.3-9-g29e619e767</FFmpegBuild>
    <FFmpegSeries>8.1</FFmpegSeries>
    <FFmpegCacheRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'third_party', 'ffmpeg'))</FFmpegCacheRoot>

    <!-- target platform: the RuntimeIdentifier when publishing for another platform, else the build machine -->
    <_FFmpegArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_FFmpegArch>
    <FFmpegRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(_FFmpegArch)</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(_FFmpegArch)</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(_FFmpegArch)</FFmpegRid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FFmpegRid)' == 'win-x64'">
    <FFmpegAsset>$(FFmpegBuild)-win64-lgpl-shared-$(FFmpegSeries).zip</FFmpegAsset>
    <FFmpegSha256>3e47bda1607740550141e37c0e49d1e5182b34699f15adfd137ee266d346811a</FFmpegSha256>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FFmpegRid)' == 'win-arm64'">
    <FFmpegAsset>$(FFmpegBuild)-winarm64-lgpl-shared-$(FFmpegSeries).zip</FFmpegAsset>
    <FFmpegSha256>7674d11915c95c8f65eeec36b329917c3023f6bae5786549cc47aed52cc1cea7</FFmpegSha256>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FFmpegRid)' == 'linux-x64'">
    <FFmpegAsset>$(FFmpegBuild)-linux64-lgpl-shared-$(FFmpegSeries).tar.xz</FFmpegAsset>
    <FFmpegSha256>d4d7b6936f492c0b866b1cb4a29a1bbae09d6a064b4ec4eb90c95bed7969535a</FFmpegSha256>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FFmpegRid)' == 'linux-arm64'">
    <FFmpegAsset>$(FFmpegBuild)-linuxarm64-lgpl-shared-$(FFmpegSeries).tar.xz</FFmpegAsset>
    <FFmpegSha256>d44838f375c66cf31a8b1473b6f8bad76e5c7dac55870c4d96a75c907a52ba2d</FFmpegSha256>
  </PropertyGroup>

  <PropertyGroup>
    <FFmpegDir>$(FFmpegCacheRoot)$(FFmpegRid)/</FFmpegDir>
    <FFmpegStamp>$(FFmpegDir).version</FFmpegStamp>
    <FFmpegUrl>https://github.com/BtbN/FFmpeg-Builds/releases/download/$(FFmpegTag)/$(FFmpegAsset)</FFmpegUrl>
    <_FFmpegWork>$(FFmpegCacheRoot).download/$(FFmpegRid)/</_FFmpegWork>
    <_FFmpegCurrent Condition="Exists('$(FFmpegStamp)')">$([System.IO.File]::ReadAllText('$(FFmpegStamp)').Trim())</_FFmpegCurrent>
  </PropertyGroup>

  <Target Name="VitaSharpFetchFFmpeg" BeforeTargets="BeforeBuild"
          Condition="'$(VitaSharpSkipFFmpeg)' != 'true' and '$(FFmpegAsset)' != '' and '$(_FFmpegCurrent)' != '$(FFmpegAsset)'">
    <Message Importance="high" Text="Downloading FFmpeg $(FFmpegSeries) for $(FFmpegRid): $(FFmpegUrl)" />
    <RemoveDir Directories="$(_FFmpegWork);$(FFmpegDir)" />
    <DownloadFile SourceUrl="$(FFmpegUrl)" DestinationFolder="$(_FFmpegWork)" Retries="3" RetryDelayMilliseconds="2000"
                  ContinueOnError="true">
      <Output TaskParameter="DownloadedFile" ItemName="_FFmpegArchive" />
    </DownloadFile>
    <Warning Condition="'@(_FFmpegArchive)' == ''"
             Text="FFmpeg could not be downloaded; videos and MP3/AAC audio will be disabled. Build again when online, or set VitaSharpSkipFFmpeg=true." />

    <GetFileHash Condition="'@(_FFmpegArchive)' != ''" Files="@(_FFmpegArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FFmpegActualSha" />
    </GetFileHash>
    <Error Condition="'@(_FFmpegArchive)' != '' and '$(_FFmpegActualSha.ToLowerInvariant())' != '$(FFmpegSha256)'"
           Text="FFmpeg archive checksum mismatch for $(FFmpegAsset): expected $(FFmpegSha256), got $(_FFmpegActualSha.ToLowerInvariant())." />

    <!-- .zip (Windows) with MSBuild's own task: the "tar" on PATH may be Git's GNU tar, which can't read zips -->
    <Unzip Condition="'@(_FFmpegArchive)' != '' and $(FFmpegAsset.EndsWith('.zip'))" SourceFiles="@(_FFmpegArchive)" DestinationFolder="$(_FFmpegWork)" />
    <!-- the tarball's soname symlinks (libavcodec.so.62 -> libavcodec.so.62.28.103) can't be created on a Windows
         host publishing for Linux; they are not needed (see below), so tar's exit code is ignored and the result is
         checked by the library count instead -->
    <Exec Condition="'@(_FFmpegArchive)' != '' and $(FFmpegAsset.EndsWith('.tar.xz'))" Command="tar -xJf &quot;@(_FFmpegArchive->'%(Filename)%(Extension)')&quot;"
          WorkingDirectory="$(_FFmpegWork)" IgnoreExitCode="true" />

    <ItemGroup Condition="'@(_FFmpegArchive)' != ''">
      <!-- only the libraries VitaSharp uses (avdevice/avfilter add ~36 MB for nothing).
           Windows: avcodec-62.dll ...; Linux: the real file libavcodec.so.62.28.103, copied under its soname
           libavcodec.so.62, which is the name FFmpeg.AutoGen loads -->
      <_FFmpegAll Include="$(_FFmpegWork)*/bin/*.dll;$(_FFmpegWork)*/lib/*.so.*.*.*" />
      <_FFmpegLib Include="@(_FFmpegAll)"
                  Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(lib)?(avcodec|avformat|avutil|swresample|swscale)[-.]'))" />
      <_FFmpegLib>
        <DestName>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)%(Extension)', '^(lib\w+\.so\.\d+)\..*$', '$1'))</DestName>
      </_FFmpegLib>
      <_FFmpegLicense Include="$(_FFmpegWork)*/LICENSE*" />
    </ItemGroup>
    <Error Condition="'@(_FFmpegArchive)' != '' and @(_FFmpegLib->Count()) != 5"
           Text="Expected 5 FFmpeg libraries in $(FFmpegAsset), found @(_FFmpegLib->Count()): @(_FFmpegLib->'%(Filename)%(Extension)', ', ')" />
    <Copy Condition="'@(_FFmpegArchive)' != ''" SourceFiles="@(_FFmpegLib)" DestinationFiles="@(_FFmpegLib->'$(FFmpegDir)%(DestName)')" />
    <Copy Condition="'@(_FFmpegArchive)' != ''" SourceFiles="@(_FFmpegLicense)" DestinationFolder="$(FFmpegDir)" />
    <WriteLinesToFile Condition="'@(_FFmpegArchive)' != ''" File="$(FFmpegStamp)" Lines="$(FFmpegAsset)" Overwrite="true" />
    <RemoveDir Directories="$(FFmpegCacheRoot).download" />
  </Target>

  <Target Name="_VitaSharpCollectFFmpeg">
    <ItemGroup>
      <_FFmpegRuntimeFile Include="$(FFmpegDir)*" Exclude="$(FFmpegStamp)" />
    </ItemGroup>
  </Target>

  <Target Name="VitaSharpCopyFFmpeg" AfterTargets="Build" DependsOnTargets="_VitaSharpCollectFFmpeg"
          Condition="'$(VitaSharpSkipFFmpeg)' != 'true'">
    <Copy SourceFiles="@(_FFmpegRuntimeFile)" DestinationFolder="$(OutDir)ffmpeg" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="VitaSharpPublishFFmpeg" AfterTargets="Publish" DependsOnTargets="_VitaSharpCollectFFmpeg"
          Condition="'$(VitaSharpSkipFFmpeg)' != 'true'">
    <Copy SourceFiles="@(_FFmpegRuntimeFile)" DestinationFolder="$(PublishDir)ffmpeg" SkipUnchangedFiles="true" />
  </Target>
</Project>
