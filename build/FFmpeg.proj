<Project DefaultTargets="Fetch">
  <!--
    Downloads and caches the FFmpeg libraries for one platform (see FFmpeg.targets). Projects call this through the
    MSBuild task instead of running the steps themselves: MSBuild builds a project with the same global properties
    once per build, so parallel projects (Desktop and Tests in a solution build) no longer race on the download.
  -->
  <Import Project="FFmpeg.Common.props" />

  <Target Name="Fetch"
          Condition="'$(VitaSharpSkipFFmpeg)' != 'true' and '$(FFmpegAsset)' != '' and '$(_FFmpegCurrent)' != '$(FFmpegAsset)'">
    <Message Importance="high" Text="Downloading FFmpeg $(FFmpegSeries) for $(FFmpegRid): $(FFmpegUrl)" />
    <RemoveDir Directories="$(_FFmpegWork);$(FFmpegDir)" />
    <DownloadFile SourceUrl="$(FFmpegUrl)" DestinationFolder="$(_FFmpegWork)" Retries="3" RetryDelayMilliseconds="2000"
                  ContinueOnError="true">
      <Output TaskParameter="DownloadedFile" ItemName="_FFmpegArchive" />
    </DownloadFile>
    <Warning Condition="'@(_FFmpegArchive)' == ''"
             Text="FFmpeg could not be downloaded; videos and MP3/AAC audio will be disabled. Build again when online, or set VitaSharpSkipFFmpeg=true." />

    <GetFileHash Condition="'@(_FFmpegArchive)' != ''" Files="@(_FFmpegArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FFmpegActualSha" />
    </GetFileHash>
    <Error Condition="'@(_FFmpegArchive)' != '' and '$(_FFmpegActualSha.ToLowerInvariant())' != '$(FFmpegSha256)'"
           Text="FFmpeg archive checksum mismatch for $(FFmpegAsset): expected $(FFmpegSha256), got $(_FFmpegActualSha.ToLowerInvariant())." />

    <!-- .zip (Windows) with MSBuild's own task: the "tar" on PATH may be Git's GNU tar, which can't read zips -->
    <Unzip Condition="'@(_FFmpegArchive)' != '' and $(FFmpegAsset.EndsWith('.zip'))" SourceFiles="@(_FFmpegArchive)" DestinationFolder="$(_FFmpegWork)" />
    <!-- the tarball's soname symlinks (libavcodec.so.62 -> libavcodec.so.62.28.103) can't be created on a Windows
         host publishing for Linux; they are not needed (see below), so tar's exit code is ignored and the result is
         checked by the library count instead -->
    <Exec Condition="'@(_FFmpegArchive)' != '' and $(FFmpegAsset.EndsWith('.tar.xz'))" Command="tar -xJf &quot;@(_FFmpegArchive->'%(Filename)%(Extension)')&quot; --exclude=*.so --exclude=*.so.[0-9] --exclude=*.so.[0-9][0-9]"
          WorkingDirectory="$(_FFmpegWork)" IgnoreExitCode="true" />

    <ItemGroup Condition="'@(_FFmpegArchive)' != ''">
      <!-- only the libraries VitaSharp uses (avdevice/avfilter add ~36 MB for nothing).
           Windows: avcodec-62.dll ...; Linux: the real file libavcodec.so.62.28.103, copied under its soname
           libavcodec.so.62, which is the name FFmpeg.AutoGen loads -->
      <_FFmpegAll Include="$(_FFmpegWork)*/bin/*.dll;$(_FFmpegWork)*/lib/*.so.*.*.*" />
      <_FFmpegLib Include="@(_FFmpegAll)"
                  Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(lib)?(avcodec|avformat|avutil|swresample|swscale)[-.]'))" />
      <_FFmpegLib>
        <DestName>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)%(Extension)', '^(lib\w+\.so\.\d+)\..*$', '$1'))</DestName>
      </_FFmpegLib>
      <_FFmpegLicense Include="$(_FFmpegWork)*/LICENSE*" />
    </ItemGroup>
    <Error Condition="'@(_FFmpegArchive)' != '' and @(_FFmpegLib->Count()) != 5"
           Text="Expected 5 FFmpeg libraries in $(FFmpegAsset), found @(_FFmpegLib->Count()): @(_FFmpegLib->'%(Filename)%(Extension)', ', ')" />
    <Copy Condition="'@(_FFmpegArchive)' != ''" SourceFiles="@(_FFmpegLib)" DestinationFiles="@(_FFmpegLib->'$(FFmpegDir)%(DestName)')" />
    <Copy Condition="'@(_FFmpegArchive)' != ''" SourceFiles="@(_FFmpegLicense)" DestinationFolder="$(FFmpegDir)" />
    <WriteLinesToFile Condition="'@(_FFmpegArchive)' != ''" File="$(FFmpegStamp)" Lines="$(FFmpegAsset)" Overwrite="true" />
    <RemoveDir Directories="$(FFmpegCacheRoot).download" />
  </Target>
</Project>
